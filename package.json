{
  "name": "plant-maintenance-form",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply plant-maintenance --local",
    "db:migrate:remote": "wrangler d1 migrations apply plant-maintenance --remote",
    "build:template": "python3 -I scripts/build_template.py template/checksheet-motor-original.docx src/template.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  }
}
